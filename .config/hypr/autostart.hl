exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

exec-once = qs
exec-once = sh -c 'wallpaper="$HOME/.local/share/hyprpaper/current-wallpaper"; if [ -e "$wallpaper" ]; then exec hyprpaper; else exec swaybg -c "#0a0a0c"; fi'
exec-once = hypridle
exec-once = sh -c 'plugin="$HOME/.local/src/hypr-autoscroll/build/hypr-autoscroll.so"; [ ! -f "$plugin" ] || hyprctl plugin load "$plugin"'
# exec-once = swaync
exec-once = blueman-applet
exec-once = clipse -listen
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# xremap was superseded by the XKB keymap toggle; keep the package installed.
# exec-once = xremap ~/.config/xremap/config.yml
